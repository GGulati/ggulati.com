---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import { pagePath } from "../lib/urls.js";

const { title, description = "Gurwinder Gulati writes technical articles and link notes." } = Astro.props;
const currentPath = pagePath(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="Gurwinder Gulati" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader currentPath={currentPath} />
    <slot />
    <SiteFooter />
    <script is:inline>
      document.querySelectorAll('a[href^="http://"], a[href^="https://"]').forEach((link) => {
        const url = new URL(link.href);
        if (url.hostname !== window.location.hostname) {
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        }
      });
    </script>
  </body>
</html>
