---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLinkPosts } from "../lib/links.js";
import { relativeUrl } from "../lib/urls.js";

const linkPosts = await getLinkPosts();
const currentPath = "/links.html";
---

<BaseLayout title="Links | Gurwinder Gulati" description="A reverse-chronological archive of Gurwinder Gulati's saved links.">
  <main id="top" class="all-links-shell">
    <section class="article-index-hero">
      <p class="eyebrow">Links</p>
      <h1>Links</h1>
    </section>
    <section class="section all-links-section" aria-label="All saved links">
      <div class="link-date-picker">
        <label for="linkDateSelect">Jump to date</label>
        <select id="linkDateSelect">
          <option value="">Select a date</option>
          {linkPosts.map((post) => <option value={relativeUrl(currentPath, post.url)}>{post.displayDate}</option>)}
        </select>
      </div>
      <div class="link-post-list">
        {
          linkPosts.map((post) => (
            <article class="link-post">
              <h3><a href={relativeUrl(currentPath, post.url)}>{post.displayDate}</a></h3>
              <ol class="daily-link-list">
                {
                  post.groups.map((group) => (
                    <li>
                      <div class="daily-link-group">
                        {group.links.map((link) => <a href={link.href}>"{link.title}"</a>)}
                      </div>
                      {group.note && <p>{group.note}</p>}
                    </li>
                  ))
                }
              </ol>
            </article>
          ))
        }
      </div>
    </section>
  </main>
  <script>
    document.querySelector("#linkDateSelect")?.addEventListener("change", (event) => {
      const target = event.currentTarget;
      if (target instanceof HTMLSelectElement && target.value) {
        window.location.href = target.value;
      }
    });
  </script>
</BaseLayout>
