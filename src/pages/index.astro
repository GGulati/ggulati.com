---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeedList from "../components/FeedList.astro";
import SideProjects from "../components/SideProjects.astro";
import { getFeedItems } from "../lib/feed.js";
import { relativeUrl } from "../lib/urls.js";

const feedItems = await getFeedItems();
const currentPath = "/index.html";
const recentCount = 5;
---

<BaseLayout title="Gurwinder Gulati | Recent Posts">
  <main id="top" class="articles-home">
    <section class="article-index-hero">
      <p class="eyebrow">Articles & Links</p>
      <h1>Recent Posts</h1>
    </section>

    <section id="feed" class="section feed-section" aria-label="Articles and links">
      <nav class="post-filter" aria-label="Post type filter">
        <button type="button" data-home-post-filter="all">All</button>
        <button type="button" data-home-post-filter="article">Articles</button>
        <button type="button" data-home-post-filter="links">Links</button>
      </nav>
      <FeedList items={feedItems} currentPath={currentPath} hiddenFrom={recentCount} />
      <p class="feed-more-link"><a href={relativeUrl(currentPath, "/posts.html#post-6")} data-home-more-link>More...</a></p>
    </section>

    <section id="side-projects" class="section side-projects-section" aria-labelledby="side-projects-heading">
      <div class="section-label">
        <p class="eyebrow">Side Projects</p>
        <h2 id="side-projects-heading">Demos</h2>
      </div>
      <SideProjects currentPath={currentPath} />
    </section>

    <section id="regular-reading" class="section regular-reading-section" aria-labelledby="regular-reading-heading">
      <div class="section-label">
        <p class="eyebrow">Reading</p>
        <h2 id="regular-reading-heading">Regular Reading</h2>
      </div>
      <div class="regular-reading-list">
        <section aria-labelledby="daily-reading-heading">
          <h3 id="daily-reading-heading">Daily</h3>
          <ul>
            <li><a href="https://www.bloomberg.com/account/newsletters/money-stuff">Matt Levine</a></li>
            <li><a href="https://stratechery.com/">Stratechery</a></li>
            <li><a href="https://marginalrevolution.com/">Marginal Revolution</a></li>
            <li><a href="https://news.ycombinator.com/">Hacker News</a></li>
            <li><a href="https://lobste.rs/">Lobste.rs</a></li>
          </ul>
        </section>
        <section aria-labelledby="weekly-reading-heading">
          <h3 id="weekly-reading-heading">Weekly</h3>
          <ul>
            <li><a href="https://acoup.blog/">A Collection of Unmitigated Pedantry</a></li>
            <li><a href="https://www.thediff.co/">The Diff</a></li>
            <li><a href="https://www.ggd.world/">Alice Evans</a></li>
            <li><a href="https://traditionsofconflict.substack.com/">Traditions of Conflict</a> (<a href="https://traditionsofconflict.com/">archive</a>)</li>
            <li><a href="https://www.astralcodexten.com/">Astral Codex Ten</a></li>
            <li><a href="https://simonwillison.net/">Simon Willison</a></li>
          </ul>
        </section>
      </div>
    </section>
  </main>
  <script is:inline>
    const recentCount = 5;
    const feedItems = Array.from(document.querySelectorAll("#feed .feed-item"));
    const filterButtons = Array.from(document.querySelectorAll("[data-home-post-filter]"));
    const moreLink = document.querySelector("[data-home-more-link]");

    function applyHomeFilter(filter) {
      const matchingItems = feedItems.filter((item) => filter === "all" || item.dataset.feedType === filter);

      feedItems.forEach((item) => {
        item.classList.toggle("feed-item-hidden", !matchingItems.slice(0, recentCount).includes(item));
      });

      filterButtons.forEach((button) => {
        button.setAttribute("aria-current", button.dataset.homePostFilter === filter ? "page" : "false");
      });

      if (moreLink) {
        const filterQuery = filter === "all" ? "" : `?type=${filter === "article" ? "articles" : "links"}`;
        moreLink.href = `posts.html${filterQuery}#post-${recentCount + 1}`;
      }
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => applyHomeFilter(button.dataset.homePostFilter));
    });

    applyHomeFilter("all");
  </script>
</BaseLayout>
