---
import ArticleIndex from "../components/ArticleIndex.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SideProjects from "../components/SideProjects.astro";
import { getArticles } from "../lib/articles.js";
import { getLinkPosts } from "../lib/links.js";
import { relativeUrl } from "../lib/urls.js";

const articles = await getArticles();
const allLinkPosts = await getLinkPosts();
const linkPosts = allLinkPosts.slice(0, 3);
const currentPath = "/index.html";
---

<BaseLayout title="Gurwinder Gulati | Articles">
  <main id="top" class="articles-home">
    <section class="article-index-hero">
      <p class="eyebrow">Technical Blog</p>
      <h1>Articles</h1>
    </section>

    <section id="articles" class="section article-index-section">
      <ArticleIndex articles={articles} currentPath={currentPath} />
    </section>

    <section id="side-projects" class="section side-projects-section" aria-labelledby="side-projects-heading">
      <div class="section-label">
        <p class="eyebrow">Side Projects</p>
        <h2 id="side-projects-heading">Demos</h2>
      </div>
      <SideProjects currentPath={currentPath} />
    </section>

    <section id="links" class="section links-section" aria-labelledby="links-heading">
      <div class="section-label">
        <p class="eyebrow">Links</p>
        <h2 id="links-heading"><a href={relativeUrl(currentPath, "/links.html")}>Links</a></h2>
      </div>
      <div class="link-date-picker">
        <label for="homeLinkDateSelect">Jump to date</label>
        <select id="homeLinkDateSelect">
          <option value="">Select a date</option>
          {allLinkPosts.map((post) => <option value={relativeUrl(currentPath, post.url)}>{post.displayDate}</option>)}
        </select>
      </div>
      <div class="link-post-list">
        {
          linkPosts.map((post) => (
            <article class="link-post">
              <h3><a href={relativeUrl(currentPath, post.url)}>{post.displayDate}</a></h3>
              <ol class="daily-link-list">
                {
                  post.groups.map((group) => (
                    <li>
                      <div class="daily-link-group">
                        {group.links.map((link) => <a href={link.href}>"{link.title}"</a>)}
                      </div>
                      {group.note && <p>{group.note}</p>}
                    </li>
                  ))
                }
              </ol>
            </article>
          ))
        }
      </div>
      <p class="section-more-link"><a href={relativeUrl(currentPath, "/links.html")}>All...</a></p>
    </section>
  </main>
  <script>
    document.querySelector("#homeLinkDateSelect")?.addEventListener("change", (event) => {
      const target = event.currentTarget;
      if (target instanceof HTMLSelectElement && target.value) {
        window.location.href = target.value;
      }
    });
  </script>
</BaseLayout>
