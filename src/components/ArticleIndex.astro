---
import { relativeUrl } from "../lib/urls.js";

const { articles, currentPath } = Astro.props;
---

<div class="article-list">
  {
    articles.map((article) => (
      <article class="article-preview">
        <div class="article-preview-meta">
          <time datetime={article.date.toISOString().slice(0, 10)}>{article.displayDate}</time>
        </div>
        <h2><a href={relativeUrl(currentPath, article.url)}>{article.title}</a></h2>
        <p>{article.excerpt}</p>
        <a href={relativeUrl(currentPath, article.url)}>Continue...</a>
      </article>
    ))
  }
</div>
