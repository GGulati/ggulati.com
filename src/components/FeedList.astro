---
import { relativeUrl } from "../lib/urls.js";

const { items, currentPath, hiddenFrom = Infinity } = Astro.props;
---

<div class="feed-list">
  {
    items.map((item, index) => (
      item.type === "article" ? (
        <article id={`post-${index + 1}`} data-feed-type="article" class:list={["feed-item", "article-preview", index >= hiddenFrom && "feed-item-hidden"]}>
          <div class="article-preview-meta">
            <time datetime={item.date.toISOString().slice(0, 10)}>{item.displayDate}</time>
            <span>Article</span>
          </div>
          <h2><a href={relativeUrl(currentPath, item.url)}>{item.title}</a></h2>
          <p>{item.excerpt}</p>
          <a href={relativeUrl(currentPath, item.url)}>Continue...</a>
        </article>
      ) : (
        <article id={`post-${index + 1}`} data-feed-type="links" class:list={["feed-item", "feed-link-post", "link-post", index >= hiddenFrom && "feed-item-hidden"]}>
          <div class="article-preview-meta">
            <time datetime={item.date.toISOString().slice(0, 10)}>{item.displayDate}</time>
            <span>Links</span>
          </div>
          <h2><a href={relativeUrl(currentPath, item.url)}>{item.title}</a></h2>
          <ol class="daily-link-list">
            {
              item.groups.map((group) => (
                <li>
                  <div class="daily-link-group">
                    {group.links.map((link) => (
                      <span class="daily-link-entry">
                        {link.prefix && <span class="daily-link-prefix">{link.prefix}</span>}
                        <a href={link.href}>"{link.title}"</a>
                        {link.after?.map((afterLink) => (
                          <>
                            {" "}
                            <span class="daily-link-annotation">
                              {afterLink.prefix && <span>{afterLink.prefix}</span>}
                              <a href={relativeUrl(currentPath, afterLink.href)}>{afterLink.title}</a>
                              {afterLink.suffix && <span>{afterLink.suffix}</span>}
                            </span>
                          </>
                        ))}
                      </span>
                    ))}
                  </div>
                  {group.note && <p>{group.note}</p>}
                </li>
              ))
            }
          </ol>
        </article>
      )
    ))
  }
</div>
