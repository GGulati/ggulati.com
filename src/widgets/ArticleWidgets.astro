---
import RateReturnWidget from "./RateReturnWidget.astro";
import SubscriptionVitalsWidget from "./SubscriptionVitalsWidget.astro";

const { widgets = [] } = Astro.props;
const needsRateReturn = widgets.includes("rate-return");
const needsSubscriptionVitals = widgets.includes("subscription-vitals");
---

{needsRateReturn && <RateReturnWidget />}
{needsSubscriptionVitals && <SubscriptionVitalsWidget />}
