{
  "name": "ggulati.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/build.ts",
    "build:debug": "tsx scripts/build.ts --include-drafts",
    "preview": "astro preview",
    "test:links": "tsx scripts/validate-link-notes.ts",
    "test:deploy": "node --import tsx --test scripts/deploy-rclone.test.ts",
    "deploy": "tsx scripts/deploy-rclone.ts",
    "deploy:dry": "tsx scripts/deploy-rclone.ts --dry-run",
    "deploy:sync": "tsx scripts/deploy-rclone.ts --mode sync",
    "deploy:sync:dry": "tsx scripts/deploy-rclone.ts --mode sync --dry-run"
  },
  "dependencies": {
    "astro": "^5.13.5",
    "markdown-it": "^15.0.0",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.20.5"
  }
}
